{
  "buildCommand": "python3 build.py",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "functions": {
    "api/availability/index.js": {
      "maxDuration": 60
    },
    "api/chat/index.js": {
      "maxDuration": 60,
      "includeFiles": "lib/chat-data.json"
    }
  },
  "redirects": [
    {
      "source": "/destinations/north/",
      "destination": "/destinations/san-juan/",
      "permanent": true
    },
    {
      "source": "/destinations/west/",
      "destination": "/destinations/san-antonio/",
      "permanent": true
    },
    {
      "source": "/destinations/south-west/",
      "destination": "/destinations/san-jose/",
      "permanent": true
    },
    {
      "source": "/destinations/east/",
      "destination": "/destinations/santa-eulalia/",
      "permanent": true
    },
    {
      "source": "/destinations/ibiza-town/",
      "destination": "/destinations/ibiza/",
      "permanent": true
    }
  ]
}
